# AI Collaboration Platform Configuration
# Copy this file to .env and customize as needed

# =================================================================
# DATABASE CONFIGURATION
# =================================================================

# MongoDB connection URI
# Default: mongodb://localhost:27017
MONGO_URI=mongodb+srv://Zeeshan:NartSuk%400300@hospitalmanagement.a9nit.mongodb.net

# Database name for storing tasks and sessions
# Default: ai_collab_team
DB_NAME=ai_collab_team

# Collection name for tasks
# Default: tasks
COLLECTION_NAME=tasks

# =================================================================
# AI SERVICE CONFIGURATION
# =================================================================

# Ollama service host
# Default: localhost
OLLAMA_HOST=localhost

# Ollama service port
# Default: 11434
OLLAMA_PORT=11434

# AI model to use for code generation
# Default: qwen2.5-coder:1.5b-instruct
# Options: qwen2.5-coder:1.5b-instruct, codellama:7b, etc.
AI_MODEL=qwen2.5-coder:1.5b-instruct

# Model download timeout (seconds)
# Default: 600 (10 minutes)
MODEL_DOWNLOAD_TIMEOUT=600

# =================================================================
# SERVICE PORT CONFIGURATION
# =================================================================

# Gateway API service port
# Default: 8000
GATEWAY_PORT=8000

# Orchestrator service port  
# Default: 8001
ORCHESTRATOR_PORT=8001

# Task service port
# Default: 8002
TASK_PORT=8002

# Frontend development server port
# Default: 3000
FRONTEND_PORT=3000

# MongoDB service port
# Default: 27017
MONGODB_PORT=27017

# =================================================================
# DEVELOPMENT CONFIGURATION
# =================================================================

# Enable debug mode (verbose logging)
# Default: false
DEBUG=false

# Log level (debug, info, warning, error)
# Default: info
LOG_LEVEL=info

# Enable hot reload for backend services
# Default: true
HOT_RELOAD=true

# Frontend development mode
# Default: development
NODE_ENV=development

# =================================================================
# DOCKER CONFIGURATION
# =================================================================

# Docker network name
# Default: ai-collaboration-network
DOCKER_NETWORK=ai-collaboration-network

# MongoDB Docker image
# Default: mongo:7.0
MONGODB_IMAGE=mongo:7.0

# Ollama Docker image
# Default: ollama/ollama:latest
OLLAMA_IMAGE=ollama/ollama:latest

# Docker volume names
MONGODB_VOLUME=mongodb_data
OLLAMA_VOLUME=ollama_data

# =================================================================
# RESOURCE LIMITS
# =================================================================

# Maximum memory for MongoDB container (optional)
# Example: 512M, 1G, 2G
MONGODB_MEMORY_LIMIT=512M

# Maximum memory for Ollama container (optional)
# Example: 2G, 4G, 8G
OLLAMA_MEMORY_LIMIT=2G

# CPU limits (optional)
# Example: 0.5, 1.0, 2.0
MONGODB_CPU_LIMIT=0.5
OLLAMA_CPU_LIMIT=1.0

# =================================================================
# SECURITY CONFIGURATION
# =================================================================

# MongoDB authentication (for production)
# Default: disabled for development
MONGO_USERNAME=
MONGO_PASSWORD=

# JWT secret for API authentication (if enabled)
# Generate with: openssl rand -base64 64
JWT_SECRET=

# CORS allowed origins (comma-separated)
# Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# =================================================================
# PERFORMANCE TUNING
# =================================================================

# Number of Uvicorn workers per service
# Default: 1 (for development)
UVICORN_WORKERS=1

# Database connection pool size
# Default: 10
DB_POOL_SIZE=10

# API request timeout (seconds)
# Default: 30
API_TIMEOUT=30

# AI model response timeout (seconds)
# Default: 120
AI_TIMEOUT=120

# =================================================================
# SCRIPT BEHAVIOR
# =================================================================

# Automatically open browser after startup
# Default: true
AUTO_OPEN_BROWSER=true

# Wait for services to be ready before proceeding
# Default: true
WAIT_FOR_READY=true

# Health check timeout (seconds)
# Default: 60
HEALTH_CHECK_TIMEOUT=60

# Maximum retries for health checks
# Default: 5
HEALTH_CHECK_RETRIES=5

# =================================================================
# LOGGING CONFIGURATION
# =================================================================

# Enable file logging
# Default: true
ENABLE_FILE_LOGGING=true

# Log directory
# Default: logs/
LOG_DIR=logs

# Log rotation (daily, weekly, monthly)
# Default: daily
LOG_ROTATION=daily

# Maximum log file size
# Default: 10M
MAX_LOG_SIZE=10M

# =================================================================
# BACKUP CONFIGURATION
# =================================================================

# Enable automatic database backups
# Default: false
ENABLE_BACKUPS=false

# Backup directory
# Default: backups/
BACKUP_DIR=backups

# Backup frequency (daily, weekly)
# Default: daily
BACKUP_FREQUENCY=daily

# Number of backups to keep
# Default: 7
BACKUP_RETENTION=7

# =================================================================
# MONITORING CONFIGURATION
# =================================================================

# Enable metrics collection
# Default: false
ENABLE_METRICS=false

# Metrics port
# Default: 9090
METRICS_PORT=9090

# Health check endpoint paths
GATEWAY_HEALTH_PATH=/health
ORCHESTRATOR_HEALTH_PATH=/health
TASK_HEALTH_PATH=/health

# =================================================================
# EXAMPLE CONFIGURATIONS
# =================================================================

# Development (default)
# - All services on localhost
# - Debug enabled
# - Hot reload enabled
# - No authentication

# Production
# DEBUG=false
# LOG_LEVEL=warning
# UVICORN_WORKERS=4
# ENABLE_METRICS=true
# ENABLE_BACKUPS=true
# MONGO_USERNAME=admin
# MONGO_PASSWORD=secure_password_here
# JWT_SECRET=your_jwt_secret_here

# Minimal Resource Usage
# OLLAMA_MEMORY_LIMIT=1G
# MONGODB_MEMORY_LIMIT=256M
# OLLAMA_CPU_LIMIT=0.5
# MONGODB_CPU_LIMIT=0.25

# High Performance
# OLLAMA_MEMORY_LIMIT=8G
# MONGODB_MEMORY_LIMIT=2G
# UVICORN_WORKERS=8
# DB_POOL_SIZE=50
# AI_TIMEOUT=300