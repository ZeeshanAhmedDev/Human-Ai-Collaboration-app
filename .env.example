# Human-AI Collaboration app environment
# Copy this file to .env and fill only the values you need.
# Never commit real API keys or database passwords.

# Database
# For the Docker-managed local MongoDB, keep this value:
MONGO_URI=mongodb://mongodb:27017
DB_NAME=ai_collab_team
MONGODB_PORT=27017

# Ollama Cloud
# The app defaults to https://ollama.com/api/generate.
# Set OLLAMA_API_KEY when using Ollama Cloud.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api/generate
OLLAMA_MODEL=qwen3-coder:480b

# Optional local Ollama
# If you run Ollama on your host machine and the app is inside Docker, use:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/api/generate
# If you run the optional dependency compose file, use:
# OLLAMA_BASE_URL=http://ollama:11434/api/generate
OLLAMA_PORT=11434

# LLM behavior and timeout settings
OLLAMA_TIMEOUT=180
OLLAMA_NUM_PREDICT=900
OLLAMA_COST_PER_1K_TOKENS=0

# Gateway and service timeouts
ORCH_TIMEOUT=900
TASK_TIMEOUT=20
TASK_REQUEST_TIMEOUT=20

# Attachment limits
MAX_ATTACHMENT_BYTES=8388608
MAX_ATTACHMENT_CHARS=12000
MAX_TOTAL_ATTACHMENT_CHARS=24000

# Frontend
REACT_APP_API_URL=http://localhost:8000/api
